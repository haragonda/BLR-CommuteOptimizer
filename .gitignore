# BLR-CommuteOptimizer v2 — .gitignore

# ── Secrets (NEVER commit) ──
.env
.env.local
.env.*.local
.env.production
.env.development

# ── Node ──
node_modules/
npm-debug.log*
yarn-debug.log*

# ── Vercel ──
.vercel/

# ── Build outputs ──
dist/
build/
out/

# ── Editor ──
.vscode/
.idea/
*.swp
*.swo

# ── macOS ──
.DS_Store
._*
.Spotlight-V100

# ── Windows ──
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs ──
*.log
logs/

# ── Coverage ──
coverage/
.nyc_output/

# ── PWA icons source files (keep PNGs, ignore PSDs/Figma exports) ──
public/icons/*.psd
public/icons/*.fig
public/icons/*.ai

# ── Certs ──
*.pem
*.key
*.crt
